.streamlit/cache/

# Data cache
data/cache/

# Parquet files (large transformed data files)
input/ark_etfs/*_Transformed_Data.parquet
input/russell_3000/*_Transformed_Data.parquet

# But keep precomputed/cache data (small, needed for Streamlit Cloud)
!input/ark_etfs/precomputed/
!input/russell_3000/precomputed/
!input/russell_3000/*_cache.parquet
!input/ark_etfs/*_cache.parquet
!input/precomputed/

